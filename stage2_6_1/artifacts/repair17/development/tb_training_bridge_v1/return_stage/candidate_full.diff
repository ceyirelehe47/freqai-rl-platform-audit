+# ================================================================ R1 门禁
+#: config-development candidate score 的存放键(Repair A 方案 B:
+#: 与指标函数同名,报告与 result artifact 按此引用)
+CONFIG_DEV_METRIC_KEY = "config_dev_D1_capture"
