+def final_eval_exposure_marker() -> Path:
+    env_val = os.environ.get(PPO262_FINAL_LOCK_ENV)
+    base = Path(env_val) if env_val else ppo262_artifacts_dir()
+    return base / _FINAL_EXPOSURE_FILENAME
