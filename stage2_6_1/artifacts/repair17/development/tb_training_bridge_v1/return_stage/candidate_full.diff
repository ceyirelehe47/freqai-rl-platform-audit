++def _churn(rows) -> float:
++    import numpy as np
++    total_changes, total_steps = 0, 0
++    for r in rows:
++        if r["actions"] is None:
++            continue
++        a = np.asarray(r["actions"])
++        total_changes += int(np.sum(np.diff(a) != 0))
++        total_steps += len(a)
++    return 100.0 * total_changes / total_steps if total_steps else None
++
