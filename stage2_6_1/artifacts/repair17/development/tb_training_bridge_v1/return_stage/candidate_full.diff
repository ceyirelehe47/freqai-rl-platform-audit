++    keys = [EpisodeKey(train_ns, fam, "D1", 0, side)
++            for fam in _OFFICIAL_FAMILIES for side in ("A", "B")]
++    return EntrySpec(entry="smoke", rung_params=rung,
++                     reference_thresholds=thr, namespace=train_ns,
