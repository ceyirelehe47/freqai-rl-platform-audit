++def _tree_hash(root: Path) -> str:
++    """rl_platform 源码树哈希(2.6.1 final.py 同款算法:键=文件名)。"""
++    files: dict[str, str] = {}
++    for f in sorted(root.rglob("*.py")):
++        files[f.name] = _sha256_file(f)
++    return "rp-" + hashlib.sha256(
++        json.dumps(files, sort_keys=True).encode()).hexdigest()
