+        "source_iteration": ENG_FIXTURE_SOURCE_ITERATION,
+        "scope": "engineering",
+        "engineering_only": True,
+        "synthetic_fixture": True,
+        "stage": "stage2_6_2",
+        "created_utc": ENG_FIXTURE_CREATED_UTC,
+        "robustness_gate": {
