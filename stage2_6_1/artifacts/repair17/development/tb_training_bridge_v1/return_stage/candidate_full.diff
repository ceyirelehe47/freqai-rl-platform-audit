++    df = attach_production_features(synthetic_ohlcv({
++        "start": start * (1.0 + 0.2 * k), "drift": 0.0002 * (k + 1),
++        "amp": 0.003, "period": 24.0 + 6.0 * k, "phase": 0.7 * k,
++        "wick": 0.0015, "bars": bars}))
