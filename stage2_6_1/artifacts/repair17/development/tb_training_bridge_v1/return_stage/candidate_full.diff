++        raise _reject()
++
++    # 3. result 绑定 + verdict
++    result = json.loads(required[QUALIFICATION_RESULT_FILENAME].read_text(
++        encoding="utf-8"))
++    checks["result_format"] = (
++        result.get("format") == QUALIFICATION_RESULT_FORMAT)
