+            **bindings, "profile": ENG_PROFILE_ID, "scope": "engineering"}),
+        "authorized_consumption": (
+            "工程 profile 的 bank 生成、V2 env 训练 256 步 smoke 与"
+            " checkpoint 冷读;不解锁任何正式 probe/core/dev-eval/final"),
+        "issued_by": (
