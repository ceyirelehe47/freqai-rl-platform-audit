+            "公共验证逻辑接通;真实正式资格仍需未来正式资格链签发"),
+    }
+    digest = qualification_plan_digest(plan)
+    (qual_dir / "qualification_plan.json").write_text(
+        json.dumps(plan, indent=2, ensure_ascii=False, sort_keys=True),
