+        (qdir / QUALIFICATION_RESULT_FILENAME).unlink()
+        try:
+            _load(v1)
+        finally:
+            (qdir / QUALIFICATION_RESULT_FILENAME).write_text(
+                content, encoding="utf-8")
+
