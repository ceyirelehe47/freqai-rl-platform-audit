++            "boundary": "generate262_bank",
++            "keys": [k.canonical() for k in keys],
++            "rung_params": json.loads(json.dumps(locked_plan_rung_params)),
++        })
++        raise _ConsumerSentinel(entry, captured)
++    return _gen
++
