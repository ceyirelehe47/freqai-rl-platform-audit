++PPO262E_BANK_DATASET_ID = "eng_bank_v1(3 families x D1 x pair0 A/B)"
++PPO262E_BANK_MAX_REPLAYS = 2
++PPO262E_BANK_MAX_SUCCESS_EPISODES = 12
++PPO262E_BANK_MAX_CANDIDATE_EPISODES = 60
