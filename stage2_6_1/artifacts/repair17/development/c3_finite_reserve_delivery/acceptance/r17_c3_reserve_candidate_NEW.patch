+    path.write_text(m.canonical({'contract':m.CONTRACT,'files':{
+        k:v for k,v in m.tree_snapshot(root).items() if k!='manifest.json'}})+'\n')
+
+
+def save(path,doc):
+    path.write_text(m.canonical(doc)+'\n')
