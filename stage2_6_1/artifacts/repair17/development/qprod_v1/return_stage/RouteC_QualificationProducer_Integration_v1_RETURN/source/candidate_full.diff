+    ensure_ascii=False))
+assert total <= 640 and episodes <= 128 and mc <= 16384, "QUOTA EXCEEDED"
+print("WITHIN BUDGET")
+PYEOF
+exit $(( rc_c01 != 0 || rc_c02 != 0 ? 3 : 0 ))
