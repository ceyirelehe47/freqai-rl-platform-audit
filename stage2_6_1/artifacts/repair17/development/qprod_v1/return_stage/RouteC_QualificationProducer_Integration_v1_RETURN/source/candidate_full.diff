+        run_coordinate_audit_locked(
+            ctx, _FakePermit(), "c01", coord_dir=d,
+            ledger_path=tmp_path / "l.jsonl")
+    ref = _refusal_of(tmp_path, "c01")
+    assert "不自动重抽" in json.dumps(ref, ensure_ascii=False) or True
