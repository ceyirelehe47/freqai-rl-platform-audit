+                           plan_digest="d")
+        s1.release()
+        s2 = QProdRunSession(state, level="level_a", iteration_id="i")
+        with pytest.raises(QProdOwnershipError, match="终态不可重入"):
+            s2.acquire({})
+        rej = list((state / "rejected_requests").glob(
+            "*terminal_state_no_reentry*"))
