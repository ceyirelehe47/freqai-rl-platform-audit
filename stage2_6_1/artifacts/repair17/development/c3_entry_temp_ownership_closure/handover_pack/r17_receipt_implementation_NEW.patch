+def fixed_temp(mod, target, monkeypatch):
+    monkeypatch.setattr(mod, 'datetime', FixedClock)
+    stamp = FixedClock.now().strftime('%Y%m%dT%H%M%S%f')
+    return target.with_name(f'.{target.name}.{os.getpid()}.{stamp}.tmp')
