    "child_process_policy": "single_builder_process"
  },
  "filter_digest": "scp-d3e1689b94af18456aba75d2488eaf3ff8fe0f694b58059ef8cb9d7e92597ee0",
  "run_process_tree_policy": "single_builder_process",
  "child_process_count": 0,
